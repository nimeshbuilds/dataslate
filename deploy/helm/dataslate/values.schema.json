{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nameOverride",
    "fullnameOverride",
    "imagePullSecrets",
    "oidc",
    "api",
    "web",
    "serviceAccount",
    "podAnnotations",
    "nodeSelector",
    "tolerations",
    "affinity",
    "postgres",
    "migrations",
    "ingress",
    "podDisruptionBudget",
    "networkPolicy",
    "execution"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "audience",
        "clientId",
        "scopes"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^$|^https://[^\\s/?#]+(?:/[^\\s?#]*)?$"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory"
              ],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotations"
      ],
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {}
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true,
      "required": [],
      "properties": {}
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "external",
        "managed"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "external",
            "managed"
          ]
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretName",
            "secretKey",
            "caSecretName",
            "caSecretKey"
          ],
          "properties": {
            "secretName": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            },
            "caSecretName": {
              "type": "string"
            },
            "caSecretKey": {
              "type": "string"
            }
          }
        },
        "managed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operatorAccepted",
            "name",
            "instances",
            "imageName",
            "storageClass",
            "storageSize",
            "resources",
            "retainOnUninstall"
          ],
          "properties": {
            "operatorAccepted": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 40
            },
            "instances": {
              "type": "integer",
              "minimum": 3,
              "maximum": 9
            },
            "imageName": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "storageSize": {
              "type": "string"
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requests",
                "limits"
              ],
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "minLength": 1
                    },
                    "memory": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "minLength": 1
                    },
                    "memory": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "retainOnUninstall": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 3600
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "annotations",
        "host",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretName",
            "externallyTerminated"
          ],
          "properties": {
            "secretName": {
              "type": "string"
            },
            "externallyTerminated": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minAvailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "webIngressFrom",
        "dnsNamespace",
        "dnsPodLabels",
        "httpsEgressCidrs",
        "postgresEgressCidrs",
        "httpsEgressPorts",
        "postgresPort"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webIngressFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object",
                "required": [
                  "cidr"
                ],
                "properties": {
                  "cidr": {
                    "type": "string"
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "dnsNamespace": {
          "type": "string"
        },
        "dnsPodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "httpsEgressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "postgresEgressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "httpsEgressPorts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "postgresPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "operatorAccepted",
        "runtimePolicyAccepted",
        "bindings",
        "kubernetesEgressCidrs",
        "kubernetesPort",
        "controller",
        "namespaces"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "operatorAccepted": {
          "type": "boolean"
        },
        "runtimePolicyAccepted": {
          "type": "boolean"
        },
        "bindings": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "workspaceId",
              "name",
              "operator",
              "image",
              "namespace",
              "serviceAccount",
              "executorInstances",
              "allowedSubjects"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "workspaceId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "operator": {
                "enum": [
                  "apache"
                ]
              },
              "image": {
                "type": "string",
                "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
              },
              "mainApplicationFile": {
                "type": "string"
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "serviceAccount": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "executorInstances": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "allowedSubjects": {
                "type": "array",
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "issuer",
                    "subject"
                  ],
                  "properties": {
                    "issuer": {
                      "type": "string",
                      "pattern": "^https://[^\\s/?#]+(?:/[^\\s?#]*)?$"
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  }
                }
              },
              "maxRunSeconds": {
                "type": "integer",
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 60,
                    "maximum": 86400
                  }
                ]
              },
              "executionKind": {
                "type": "string",
                "enum": [
                  "approved-app",
                  "notebook-python-batch"
                ],
                "description": "Omitted means approved-app. notebook-python-batch is an explicit arbitrary Python engineering capability under the bound workload identity."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "executionKind": {
                      "const": "notebook-python-batch"
                    }
                  },
                  "required": [
                    "executionKind"
                  ]
                },
                "then": {
                  "properties": {
                    "mainApplicationFile": {
                      "const": ""
                    }
                  }
                },
                "else": {
                  "required": [
                    "mainApplicationFile"
                  ],
                  "properties": {
                    "mainApplicationFile": {
                      "pattern": "^local:///[^\\s?#]+\\.py$"
                    }
                  }
                }
              }
            ]
          }
        },
        "kubernetesEgressCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "kubernetesPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replicas",
            "image",
            "resources"
          ],
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag",
                "digest",
                "pullPolicy"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[a-f0-9]{64}$"
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requests",
                "limits"
              ],
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "minLength": 1
                    },
                    "memory": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "minLength": 1
                    },
                    "memory": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "namespaces": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataSlate production deployment values"
}
