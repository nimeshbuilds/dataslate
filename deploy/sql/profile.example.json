{
  "name": "dataslate-trino",
  "namespace": "dataslate-sql",
  "serviceIP": "10.43.240.10",
  "tlsSecret": "trino-tls",
  "authSecret": "trino-auth",
  "catalogSecret": "trino-catalogs",
  "jwtIssuer": "https://identity.example.com/engine",
